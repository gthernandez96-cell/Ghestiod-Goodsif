# ==============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO — DIGITALOCEAN & DESARROLLO LOCAL
# ==============================================================================

# ===== 1. SEGURIDAD & ENTORNO =====
# En producción genera una clave aleatoria de 64 caracteres con: openssl rand -hex 32
SECRET_KEY=clave-secreta-pos-2024
DEBUG=True
DJANGO_ALLOWED_HOSTS=".ondigitalocean.app,localhost,127.0.0.1"

# ===== 2. BASE DE DATOS POSTGRESQL (DIGITALOCEAN DEV DATABASE $7/mes) =====
# En local déjalo vacío o comenta la línea para usar SQLite/PostgreSQL local automáticamente.
# En DigitalOcean App Platform pega el Connection String que te entrega la base de datos:
DATABASE_URL=postgresql://doadmin:TU_PASSWORD@db-postgresql-nyc1-xxxxx.b.db.ondigitalocean.com:25060/defaultdb?sslmode=require

# ===== 3. DIGITALOCEAN SPACES (ALMACENAMIENTO DE FOTOS Y PDFs $5/mes) =====
# Obtenidos en DigitalOcean > Spaces Object Storage > API Keys:
SPACES_ACCESS_KEY=TU_SPACES_ACCESS_KEY
SPACES_SECRET_KEY=TU_SPACES_SECRET_KEY
SPACES_BUCKET_NAME=nombre-de-tu-bucket
SPACES_REGION=nyc3

# ===== 4. CONFIGURACIONES ADICIONALES (OPCIONALES) =====
APP_NAME="POS Empresarial"
APP_VERSION="1.0.0"
ENVIRONMENT=development
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
