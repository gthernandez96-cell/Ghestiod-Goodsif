# ===== BASE DE DATOS =====
POSTGRES_USER=pos_user
POSTGRES_PASSWORD=pos_pass_secure_2024
POSTGRES_DB=pos_db
DATABASE_URL=postgresql+asyncpg://pos_user:pos_pass_secure_2024@db:5432/pos_db
DATABASE_URL_SYNC=postgresql://pos_user:pos_pass_secure_2024@db:5432/pos_db

# ===== REDIS =====
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ===== SEGURIDAD =====
SECRET_KEY=cambia-esta-clave-secreta-muy-larga-y-segura-2024
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=30

# ===== APLICACION =====
APP_NAME="POS Empresarial"
APP_VERSION="1.0.0"
ENVIRONMENT=development
DEBUG=true
ALLOWED_ORIGINS=["http://localhost", "http://localhost:8000", "http://127.0.0.1:8000"]

# ===== FEL (Factura Electronica en Linea - Guatemala) =====
FEL_PROVIDER=generic  # infile | megaprint | g4s | generic
FEL_API_URL=https://api.fel.com.gt
FEL_API_KEY=tu-api-key-fel
FEL_CERTIFICATE_ID=tu-certificado-id
FEL_SIGNER_USER=usuario-firmador
FEL_SIGNER_PASS=password-firmador

# ===== EMAIL =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-email@gmail.com
SMTP_PASSWORD=tu-app-password
EMAILS_FROM=noreply@tu-empresa.com
EMAILS_FROM_NAME="POS Empresarial"

# ===== EMPRESA INICIAL =====
INIT_COMPANY_NAME="Mi Empresa S.A."
INIT_COMPANY_NIT=123456789
INIT_ADMIN_EMAIL=admin@empresa.com
