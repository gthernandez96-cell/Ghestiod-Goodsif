# ==============================================================================
# CONFIGURACIÓN DE PRODUCCIÓN — POS EMPRESARIAL (DIGITALOCEAN & POSTGRESQL)
# ==============================================================================
# Copia este archivo a `.env.production` en tu servidor y reemplaza los valores secretos.

# ===== 1. ENTORNO & APLICACIÓN =====
APP_NAME="POS Empresarial"
APP_VERSION="1.0.0"
ENVIRONMENT=production
DEBUG=false

# ===== 2. BASE DE DATOS POSTGRESQL (ALTA CONCURRENCIA) =====
# Si usas DigitalOcean Managed PostgreSQL:
# Obtén el Connection String desde el panel de DigitalOcean y asegúrate de que use asyncpg:
# Ej: postgresql+asyncpg://doadmin:AVNS_xxxx@db-pos-nyc1-xxxxx.b.db.ondigitalocean.com:25060/defaultdb?ssl=require
DATABASE_URL=postgresql+asyncpg://pos_user:PON_AQUI_UN_PASSWORD_SEGURO@db:5432/pos_db
DATABASE_URL_SYNC=postgresql://pos_user:PON_AQUI_UN_PASSWORD_SEGURO@db:5432/pos_db

# Parámetros de Connection Pooling (PostgreSQL):
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
# Si usas Connection Pooler (PgBouncer) de DigitalOcean en modo transacción, cambia a true:
DB_PGBOUNCER=false

# ===== 3. REDIS (CACHÉ, WEBSOCKETS Y CELERY) =====
REDIS_PASSWORD=GENERA_UN_PASSWORD_LARGO_PARA_REDIS
REDIS_URL=redis://:GENERA_UN_PASSWORD_LARGO_PARA_REDIS@redis:6379/0
CELERY_BROKER_URL=redis://:GENERA_UN_PASSWORD_LARGO_PARA_REDIS@redis:6379/1
CELERY_RESULT_BACKEND=redis://:GENERA_UN_PASSWORD_LARGO_PARA_REDIS@redis:6379/2

# ===== 4. SEGURIDAD & CRIPTOGRAFÍA =====
# Genera una clave aleatoria de 64 caracteres en tu terminal con: openssl rand -hex 32
SECRET_KEY=CAMBIA_ESTO_POR_UNA_CLAVE_ALEATORIA_MUY_LARGA_DE_64_CARACTERES
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=30

# Dominios permitidos para CORS (Reemplaza con tu dominio real con HTTPS):
ALLOWED_ORIGINS=["https://tudominio.com", "https://pos.tudominio.com"]

# ===== 5. FACTURACIÓN ELECTRÓNICA SAT GUATEMALA (FEL) =====
FEL_PROVIDER=generic  # infile | megaprint | g4s | digifact | generic
FEL_API_URL=https://fel.sat.gob.gt/api/v1
FEL_API_KEY=tu_api_key_certificador
FEL_CERTIFICATE_ID=tu_certificado_id
FEL_SIGNER_USER=usuario_firmador
FEL_SIGNER_PASS=password_firmador

# ===== 6. CORREOS ELECTRÓNICOS NOTIFICACIONES (SMTP) =====
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=tu_sendgrid_o_mailgun_api_key
EMAILS_FROM=facturacion@tudominio.com
EMAILS_FROM_NAME="POS Empresarial"

# ===== 7. INICIALIZACIÓN ADMINISTRADOR =====
INIT_COMPANY_NAME="Mi Empresa S.A."
INIT_COMPANY_NIT="123456789"
INIT_ADMIN_EMAIL=admin@tudominio.com
INIT_ADMIN_PASSWORD=GeneraUnPasswordFuerteAdmin2026$
